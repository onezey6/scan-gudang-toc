Set UAC = CreateObject("Shell.Application")
cmd = "-NoProfile -ExecutionPolicy Bypass -Command ""Add-Type -AssemblyName System.Windows.Forms; $f = [System.IO.Path]::Combine($env:windir, 'System32\drivers\etc\hosts'); $c = [System.IO.File]::ReadAllText($f); if ($c -notmatch 'logistik\.toc') { [System.IO.File]::AppendAllText($f, [Environment]::NewLine + '127.0.0.1 logistik.toc' + [Environment]::NewLine + '127.0.0.1 www.logistik.toc' + [Environment]::NewLine) }; Clear-DnsClientCache -ErrorAction SilentlyContinue; ipconfig /flushdns; [System.Windows.Forms.MessageBox]::Show('Domain logistik.toc BERHASIL dipasang!' + [Environment]::NewLine + [Environment]::NewLine + 'Sekarang Anda bisa langsung membuka http://logistik.toc di browser!', 'LOGISTIK.TOC - Sukses', 0, 64)"""
UAC.ShellExecute "powershell.exe", cmd, "", "runas", 1
